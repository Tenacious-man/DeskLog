<Window x:Class="DeskLog.App.MonthWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="月度工作记录" Style="{StaticResource {x:Type Window}}" Width="630" Height="700" MinWidth="460" MinHeight="400" WindowStartupLocation="CenterScreen">
 <Grid Margin="30">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="月度工作记录" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="把做过的事留下来，月底就不必从头回忆。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></DockPanel>
  <StackPanel Grid.Row="1" Margin="0,25,0,18"><DockPanel><Button Content="‹" Click="PreviousClick" DockPanel.Dock="Left" FontSize="18" ToolTip="上个月"/><Button x:Name="NextButton" Content="›" Click="NextClick" DockPanel.Dock="Right" FontSize="18" ToolTip="下个月"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><ComboBox x:Name="YearInput" Width="82" SelectionChanged="MonthSelected" AutomationProperties.Name="年份"/><TextBlock Text="年" Margin="6,0,12,0" VerticalAlignment="Center"/><ComboBox x:Name="MonthInput" Width="52" SelectionChanged="MonthSelected" AutomationProperties.Name="月份"/><TextBlock Text="月" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></DockPanel><TextBlock x:Name="CountLabel" Foreground="{StaticResource Accent}" Margin="0,18,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="2"><StackPanel><TextBlock x:Name="EmptyLabel" Text="这个月还没有完成记录。&#10;在任务板上勾选完成后，记录会自动出现在这里。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="27" Margin="0,30,0,0"/><StackPanel x:Name="RecordsList"/></StackPanel></ScrollViewer>
  <DockPanel Grid.Row="3" Margin="0,18,0,0"><TextBlock x:Name="ErrorLabel" TextWrapping="Wrap" Foreground="#AC4235" VerticalAlignment="Center"/><Button Content="回到本月" Click="TodayClick" HorizontalAlignment="Right"/></DockPanel>
 </Grid>
</Window>
