<Window x:Class="DeskLog.App.TaskEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="添加任务" Style="{StaticResource {x:Type Window}}" Width="480" Height="620" MinWidth="420" MinHeight="530" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="Heading" Text="记下下一件事" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="名称就够了，其他内容可以以后补充。" Foreground="{StaticResource Muted}" Margin="0,8,0,22"/></StackPanel>
  <ScrollViewer Grid.Row="1"><StackPanel>
   <TextBlock Text="任务名称 *" Margin="0,0,0,7"/><TextBox x:Name="TitleInput" MaxLength="200" AutomationProperties.Name="任务名称"/>
   <TextBlock Text="截止日期（选填）" Margin="0,18,0,7"/>
   <DockPanel><Button Content="清除" DockPanel.Dock="Right" Margin="8,0,0,0" Click="ClearDueClick"/><DatePicker x:Name="DueInput" SelectedDateFormat="Short" AutomationProperties.Name="截止日期"/></DockPanel>
   <TextBlock Text="备注（选填）" Margin="0,18,0,7"/><TextBox x:Name="NotesInput" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" MaxLength="10000" AutomationProperties.Name="备注"/>
   <CheckBox x:Name="CompletedInput" Content="这件事已完成" Foreground="{StaticResource Ink}" Margin="0,18,0,10" Checked="CompletedChanged" Unchecked="CompletedChanged"/>
   <StackPanel x:Name="CompletedSection" Visibility="Collapsed"><TextBlock Text="完成日期" Margin="0,0,0,7"/><DatePicker x:Name="CompletedDateInput" SelectedDateFormat="Short" AutomationProperties.Name="完成日期"/></StackPanel>
  </StackPanel></ScrollViewer>
  <TextBlock Grid.Row="2" x:Name="ErrorLabel" Foreground="#AC4235" TextWrapping="Wrap" Margin="0,12,0,6"/>
  <DockPanel Grid.Row="3" Margin="0,12,0,0"><Button x:Name="DeleteButton" Content="删除任务" Background="Transparent" Foreground="#A4443C" Padding="0,9,10,9" DockPanel.Dock="Left" Click="DeleteClick"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Margin="0,0,8,0" IsCancel="True" Click="CancelClick"/><Button Content="保存任务" Background="#32765B" Foreground="#FFFFFF" IsDefault="True" Click="SaveClick"/></StackPanel></DockPanel>
 </Grid>
</Window>
